{
  "manifest_version": 3,
  "name": "Profile Score for LinkedIn",
  "version": "0.1.0",
  "description": "Scores your LinkedIn profile for your actual goal. Runs entirely in your browser. Not affiliated with LinkedIn Corporation.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "dist/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Score this profile",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
